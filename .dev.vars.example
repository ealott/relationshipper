# Copy to .dev.vars for local development (it's gitignored).
# Web Push keys: run `npm run vapid` and paste both lines here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Sign in without Google on localhost (never set this in production).
DEV_LOGIN=true
# Who can open /admin locally.
ADMIN_EMAILS=admin@example.com
# Optional: test real Google sign-in locally (add http://localhost:5173/api/auth/google/callback
# as an authorized redirect URI on your OAuth client).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
